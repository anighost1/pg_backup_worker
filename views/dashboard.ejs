<%- include('layout', { body: ` <section class="stats">

    <div class="stat-card">
        <span>Total Backups</span>
        <strong>${stats.totalBackups}</strong>
    </div>

    <div class="stat-card">
        <span>Backup Size</span>
        <strong>${stats.totalBackupSizeMB} MB</strong>
    </div>

    <div class="stat-card">
        <span>Log Files</span>
        <strong>${stats.logFiles}</strong>
    </div>

    <div class="stat-card">
        <span>Server Time</span>
        <strong>${stats.serverTime}</strong>
    </div>

    </section>

    <p id="lastUpdated"></p>


    <section class="card">

        <h2>Backup Status</h2>

        <div class="chart-wrapper">
            <canvas id="backupChart"></canvas>
        </div>

        <div class="status-row">
            <div class="status-chip success">
                <span>Success</span>
                <strong id="successCount">0</strong>
            </div>
            <div class="status-chip failure">
                <span>Failure</span>
                <strong id="failureCount">0</strong>
            </div>
        </div>

    </section>


    <section class="card">

        <div class="section-head">
            <h2>Backup Dates</h2>
            <a class="btn" href="${basePath}/backups">Open Backup Manager &rarr;</a>
        </div>

        ${backupDates.length
            ? `<ul class="inline-list">${backupDates.map(d => `<li>${d}</li>`).join("")}</ul>`
            : `<p class="empty-state">No backup dates found.</p>`}

    </section>


    <section class="card">

        <h2>Logs</h2>

        ${logs.length ? `<ul class="log-list">
            ${logs.map(l => `
            <li class="log-item">

                <a href="${basePath}/logs/${l.name}" target="_blank">
                    ${l.name}
                </a>

                <span class="log-size">
                    ${l.size} KB
                </span>

            </li>
            `).join("")}
        </ul>` : `<p class="empty-state">No log files found.</p>`}

    </section>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        let chart;

        document.addEventListener("DOMContentLoaded", () => {
            loadStats();
            setInterval(loadStats, 10000);
        });

        async function loadStats() {

            try {

                const res = await fetch("${basePath}/api/stats");
                const data = await res.json();

                if (!data.backups) return;

                const success = Number(data.backups.success || 0);
                const failure = Number(data.backups.failure || 0);

                const canvas = document.getElementById("backupChart");

                if (!chart) {

                    chart = new Chart(canvas.getContext("2d"), {
                        type: "doughnut",
                        data: {
                            labels: ["Success", "Failure"],
                            datasets: [{
                                data: [success, failure],
                                backgroundColor: ["#20c073", "#f05d4f"],
                                borderColor: "#ffffff",
                                borderWidth: 4,
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: "68%",
                            plugins: {
                                legend: {
                                    position: "bottom",
                                    labels: {
                                        boxWidth: 10,
                                        boxHeight: 10,
                                        usePointStyle: true
                                    }
                                }
                            }
                        }
                    });

                } else {

                    chart.data.datasets[0].data = [success, failure];
                    chart.update();

                }

                document.getElementById("lastUpdated").innerText =
                    "Last updated: " + data.time;
                document.getElementById("successCount").innerText = success;
                document.getElementById("failureCount").innerText = failure;

            } catch (err) {

                console.error("Failed to load stats", err);

            }

        }

    </script>

    ` }) %>
