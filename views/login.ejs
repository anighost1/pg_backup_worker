<!DOCTYPE html>
<html>

<head>
    <title>Login | PG Backup Worker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="<%= basePath %>/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            min-width: 320px;
            -webkit-text-size-adjust: 100%;
        }

        body {
            display: grid;
            min-height: 100vh;
            margin: 0;
            place-items: center;
            background:
                linear-gradient(135deg, rgba(40, 116, 90, 0.11) 0, rgba(79, 109, 245, 0.08) 42%, rgba(247, 248, 251, 0) 72%),
                linear-gradient(180deg, #f5faf7 0, #f7f8fb 260px, #f7f8fb 100%);
            color: #172033;
            font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            line-height: 1.5;
            padding: 24px;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }

        .login-card {
            width: min(100%, 420px);
            padding: 28px;
            border: 1px solid #e1e7ef;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.94);
            box-shadow: 0 22px 60px rgba(23, 32, 51, 0.1);
            backdrop-filter: blur(10px);
        }

        .eyebrow {
            display: block;
            margin-bottom: 8px;
            color: #28745a;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 1.45rem;
            line-height: 1.2;
        }

        p {
            margin: 0 0 22px;
            color: #687386;
            font-size: 0.92rem;
        }

        label {
            display: block;
            margin-bottom: 7px;
            color: #3b4658;
            font-size: 0.86rem;
            font-weight: 700;
        }

        input {
            width: 100%;
            min-height: 44px;
            margin-bottom: 16px;
            padding: 10px 12px;
            border: 1px solid #cfd7e6;
            border-radius: 8px;
            background: #fff;
            color: #172033;
            font: inherit;
            outline: none;
        }

        input:focus {
            border-color: #28745a;
            box-shadow: 0 0 0 4px rgba(40, 116, 90, 0.12);
        }

        button {
            width: 100%;
            min-height: 44px;
            border: 1px solid #172033;
            border-radius: 8px;
            background: #172033;
            color: #fff;
            cursor: pointer;
            font: inherit;
            font-weight: 700;
        }

        button:hover {
            background: #273247;
        }

        .alert {
            margin-bottom: 16px;
            padding: 10px 12px;
            border: 1px solid #f4d8d4;
            border-radius: 8px;
            background: #fff7f6;
            color: #9f2d24;
            font-size: 0.88rem;
            font-weight: 650;
        }

        @media (max-width: 520px) {
            body {
                align-items: start;
                padding: 18px 12px;
            }

            .login-card {
                padding: 22px;
            }
        }
    </style>
</head>

<body>
    <main class="login-card">
        <span class="eyebrow">PG Backup Worker</span>
        <h1>Sign in</h1>
        <p>Use your dashboard credentials to continue.</p>

        <% if (locked) { %>
            <div class="alert">Too many failed attempts. Try again in a few minutes.</div>
        <% } else if (error) { %>
            <div class="alert">Invalid username or password.</div>
        <% } %>

        <form method="POST" action="<%= basePath %>/login" autocomplete="off">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">

            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" required autofocus>

            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>

            <button type="submit">Sign in</button>
        </form>
    </main>
</body>

</html>
