<!DOCTYPE html>
<html>

<head>
    <title>Backups</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
            background:
                linear-gradient(135deg, rgba(40, 116, 90, 0.08) 0, rgba(79, 109, 245, 0.06) 42%, rgba(247, 248, 251, 0) 72%),
                linear-gradient(180deg, #f5faf7 0, #f7f8fb 240px, #f7f8fb 100%);
            color: #172033;
            font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            line-height: 1.5;
            min-height: 100vh;
            padding: 28px 0 40px;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }

        h1 {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 650;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 22px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e7eaf0;
        }

        .title-group span {
            display: block;
            margin-bottom: 6px;
            color: #28745a;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .back-link {
            color: #566276;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.18s ease, transform 0.18s ease;
        }

        .back-link:hover {
            color: #172033;
            transform: translateX(-2px);
        }

        .date-section {
            margin-bottom: 14px;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #e8ebf1;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(23, 32, 51, 0.05);
            backdrop-filter: blur(10px);
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
        }

        .date-section.active {
            border-color: #d8efe3;
            box-shadow: 0 12px 32px rgba(23, 32, 51, 0.06);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 15px 16px;
            background: rgba(255, 255, 255, 0.86);
            color: #172033;
            cursor: pointer;
            transition: background 0.18s ease;
        }

        .header:hover {
            background: #fafdfb;
        }

        .header h2 {
            font-size: 0.98rem;
            font-weight: 650;
            margin: 0;
        }

        .date-title {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .file-count {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            padding: 4px 9px;
            border: 1px solid #d8efe3;
            border-radius: 999px;
            background: #f4fbf7;
            color: #146c43;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .arrow {
            margin-right: 10px;
            color: #687386;
            transition: transform 0.2s;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 11px 14px;
            border-top: 1px solid #edf0f5;
            font-size: 0.9rem;
            overflow-wrap: anywhere;
        }

        tbody tr {
            transition: background 0.16s ease;
        }

        tbody tr:hover {
            background: #fbfcfd;
        }

        th {
            background: #fafbfc;
            color: #687386;
            font-size: 0.75rem;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
        }

        .download {
            color: #146c43;
            font-weight: 650;
            text-decoration: none;
            white-space: nowrap;
        }

        .download:hover {
            text-decoration: underline;
        }

        .download-all,
        .back-link {
            display: inline-flex;
            align-items: center;
            min-height: 34px;
        }

        .download-all {
            padding: 8px 12px;
            border: 1px solid #cfd7e6;
            border-radius: 6px;
            background: #172033;
            color: #fff;
            font-size: 0.86rem;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
        }

        .download-all:hover {
            background: #273247;
            box-shadow: 0 8px 20px rgba(23, 32, 51, 0.16);
            transform: translateY(-1px);
        }

        .content {
            display: none;
            overflow-x: auto;
        }

        .date-section.active .content {
            display: block;
        }

        .date-section.active .arrow {
            transform: rotate(90deg);
        }

        .empty-state {
            margin: 24px 0;
            color: #687386;
        }

        @media (max-width: 640px) {
            body {
                width: min(100% - 24px, 1120px);
                background:
                    linear-gradient(135deg, rgba(40, 116, 90, 0.09) 0, rgba(79, 109, 245, 0.05) 48%, rgba(247, 248, 251, 0) 78%),
                    linear-gradient(180deg, #f5faf7 0, #f7f8fb 210px, #f7f8fb 100%);
                padding-top: 22px;
            }

            .topbar,
            .header {
                align-items: stretch;
                flex-direction: column;
            }

            .topbar {
                gap: 14px;
            }

            h1 {
                font-size: 1.28rem;
                line-height: 1.25;
            }

            .back-link {
                align-self: flex-start;
            }

            .date-section {
                margin-bottom: 12px;
            }

            .header {
                padding: 14px;
            }

            .date-title {
                align-items: flex-start;
            }

            .file-count {
                align-self: flex-start;
            }

            .download-all {
                width: 100%;
                justify-content: center;
            }

            table,
            thead,
            tbody,
            tr,
            th,
            td {
                display: block;
            }

            thead {
                display: none;
            }

            tr {
                padding: 12px 14px;
                border-top: 1px solid #edf0f5;
            }

            td {
                display: grid;
                grid-template-columns: 88px minmax(0, 1fr);
                gap: 12px;
                padding: 7px 0;
                border-top: 0;
            }

            td::before {
                content: attr(data-label);
                color: #687386;
                font-size: 0.76rem;
                font-weight: 700;
                text-transform: uppercase;
            }

            .download {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 36px;
                padding: 7px 10px;
                border: 1px solid #d8efe3;
                border-radius: 6px;
                background: #f4fbf7;
            }
        }
    </style>
</head>

<body>

    <div class="topbar">
        <div class="title-group">
            <span>Backup Manager</span>
            <h1>Database Backups</h1>
        </div>
        <a class="back-link" href="<%= basePath %>/">&larr; Dashboard</a>
    </div>

    <% if (Object.keys(backups).length === 0) { %>
        <p class="empty-state">No backups found.</p>
    <% } %>

    <% Object.keys(backups).forEach((date, index)=> { %>

        <div class="date-section <%= index === 0 ? 'active' : '' %>">

            <div class="header">

                <div class="date-title">
                    <span class="arrow">&#9656;</span>
                    <h2>
                        <%= date %>
                    </h2>
                </div>

                <span class="file-count"><%= backups[date].length %> file<%= backups[date].length === 1 ? '' : 's' %></span>

                <a class="download-all" href="<%= basePath %>/api/backups/download-date/<%= date %>" onclick="event.stopPropagation()">
                    Download All
                </a>

            </div>

            <div class="content">

                <table>

                    <thead>
                        <tr>
                            <th>Database</th>
                            <th>File</th>
                            <th>Size MB</th>
                            <th>Download</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% backups[date].forEach(b=> { %>

                            <tr>
                                <td data-label="Database">
                                    <%= b.database %>
                                </td>
                                <td data-label="File">
                                    <%= b.file %>
                                </td>
                                <td data-label="Size MB">
                                    <%= b.size %>
                                </td>

                                <td data-label="Download">
                                    <a class="download" href="<%= b.url %>">
                                        Download
                                    </a>
                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

        <% }) %>

            <script>

                document.querySelectorAll(".header").forEach(header => {

                    header.addEventListener("click", () => {

                        const section = header.parentElement;

                        section.classList.toggle("active");

                    });

                });

            </script>

</body>

</html>
